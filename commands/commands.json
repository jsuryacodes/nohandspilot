{
  "version": 1,
  "triggerWords": ["pilot", "hey pilot", "ok pilot", "okay pilot", "hi pilot"],
  "fillerWords": ["um", "uh", "erm", "please", "can you", "could you", "would you", "the", "a", "an", "just", "my"],
  "synonyms": {
    "launch": "open",
    "start": "open",
    "bring up": "open",
    "go to": "switch to",
    "jump to": "switch to",
    "focus": "switch to",
    "shut": "close",
    "kill": "quit",
    "refresh": "reload",
    "google": "search for",
    "look up": "search for",
    "search": "search for",
    "search for": "search for",
    "minimize": "minimise",
    "fullscreen": "full screen"
  },
  "apps": {
    "chrome": "Google Chrome",
    "google chrome": "Google Chrome",
    "browser": "Google Chrome",
    "claude": "Claude",
    "cloud": "Claude",
    "code": "Visual Studio Code",
    "vs code": "Visual Studio Code",
    "vscode": "Visual Studio Code",
    "visual studio": "Visual Studio Code",
    "finder": "Finder",
    "files": "Finder",
    "terminal": "Terminal",
    "settings": "System Settings"
  },
  "hotkey": "ctrl+opt+p",
  "commands": [
    { "id": "open_app", "phrases": ["open {app}", "switch to {app}", "show {app}"], "action": { "type": "openApp" }, "say": "Opened {app}" },
    { "id": "quit_app", "phrases": ["quit {app}", "close {app}"], "action": { "type": "quitApp" }, "say": "Quit {app}" },
    { "id": "help", "phrases": ["what can i say", "help", "show commands"], "action": { "type": "help" }, "say": "Commands" },

    { "id": "new_tab", "phrases": ["new tab", "open new tab"], "action": { "type": "keys", "keys": "cmd+t" }, "say": "New tab" },
    { "id": "close_tab", "phrases": ["close tab", "close this tab"], "action": { "type": "keys", "keys": "cmd+w" }, "say": "Closed tab" },
    { "id": "reopen_tab", "phrases": ["reopen tab", "reopen closed tab", "undo close tab"], "action": { "type": "keys", "keys": "cmd+shift+t" }, "say": "Reopened tab" },
    { "id": "next_tab", "phrases": ["next tab"], "action": { "type": "keys", "keys": "ctrl+tab" }, "say": "Next tab" },
    { "id": "previous_tab", "phrases": ["previous tab", "last tab"], "action": { "type": "keys", "keys": "ctrl+shift+tab" }, "say": "Previous tab" },
    { "id": "scroll_down", "phrases": ["scroll down", "scroll"], "action": { "type": "scroll", "direction": "down" }, "say": "Scrolled down" },
    { "id": "scroll_up", "phrases": ["scroll up"], "action": { "type": "scroll", "direction": "up" }, "say": "Scrolled up" },
    { "id": "scroll_top", "phrases": ["scroll to top", "go to top", "top of page"], "action": { "type": "keys", "keys": "cmd+up" }, "say": "Top" },
    { "id": "scroll_bottom", "phrases": ["scroll to bottom", "go to bottom", "bottom of page"], "action": { "type": "keys", "keys": "cmd+down" }, "say": "Bottom" },
    { "id": "next_window", "phrases": ["next window", "switch window"], "action": { "type": "keys", "keys": "cmd+`" }, "say": "Next window" },
    { "id": "minimise", "phrases": ["minimise", "minimise window"], "action": { "type": "keys", "keys": "cmd+m" }, "say": "Minimised" },
    { "id": "full_screen", "phrases": ["full screen", "toggle full screen"], "action": { "type": "keys", "keys": "ctrl+cmd+f" }, "say": "Full screen" },
    { "id": "type_text", "phrases": ["type {text}"], "action": { "type": "type", "text": "{text}" }, "say": "Typed" },
    { "id": "press_enter", "phrases": ["press enter", "enter", "submit", "send"], "action": { "type": "keys", "keys": "enter" }, "say": "Enter" },
    { "id": "escape", "phrases": ["escape", "press escape", "cancel"], "action": { "type": "keys", "keys": "esc" }, "say": "Escape" },
    { "id": "web_search", "phrases": ["search for {query}"], "action": { "type": "sequence", "steps": ["open:Google Chrome", "cmd+t", "type:{query}", "enter"] }, "say": "Searching {query}" },
    { "id": "undo", "phrases": ["undo"], "action": { "type": "keys", "keys": "cmd+z" }, "say": "Undo" },

    { "id": "chrome_search", "app": "Google Chrome", "phrases": ["search for {query}"], "action": { "type": "sequence", "steps": ["cmd+l", "type:{query}", "enter"] }, "say": "Searching {query}" },
    { "id": "chrome_back", "app": "Google Chrome", "phrases": ["go back", "back"], "action": { "type": "keys", "keys": "cmd+[" }, "say": "Back" },
    { "id": "chrome_forward", "app": "Google Chrome", "phrases": ["go forward", "forward"], "action": { "type": "keys", "keys": "cmd+]" }, "say": "Forward" },
    { "id": "chrome_reload", "app": "Google Chrome", "phrases": ["reload", "reload page"], "action": { "type": "keys", "keys": "cmd+r" }, "say": "Reloaded" },
    { "id": "chrome_address", "app": "Google Chrome", "phrases": ["address bar", "focus address bar"], "action": { "type": "keys", "keys": "cmd+l" }, "say": "Address bar" },
    { "id": "chrome_new_window", "app": "Google Chrome", "phrases": ["new window"], "action": { "type": "keys", "keys": "cmd+n" }, "say": "New window" },
    { "id": "chrome_incognito", "app": "Google Chrome", "phrases": ["incognito", "new incognito window"], "action": { "type": "keys", "keys": "cmd+shift+n" }, "say": "Incognito" },
    { "id": "chrome_sidebar", "app": "Google Chrome", "phrases": ["toggle sidebar", "open sidebar", "close sidebar", "sidebar"], "action": { "type": "keys", "keys": "TODO", "note": "Chrome has no fixed side panel shortcut; set one in chrome://extensions/shortcuts or pick a panel" }, "say": "Sidebar" },

    { "id": "claude_new_chat", "app": "Claude", "phrases": ["new chat", "new conversation"], "action": { "type": "keys", "keys": "cmd+n" }, "say": "New chat" },
    { "id": "claude_sidebar", "app": "Claude", "phrases": ["toggle sidebar", "open sidebar", "close sidebar", "sidebar"], "action": { "type": "keys", "keys": "cmd+b" }, "say": "Sidebar" },
    { "id": "claude_search", "app": "Claude", "phrases": ["search chats", "command palette", "search for {query}"], "action": { "type": "sequence", "steps": ["cmd+k", "wait:150", "type:{query}"] }, "say": "Search" },

    { "id": "code_sidebar", "app": "Visual Studio Code", "phrases": ["toggle sidebar", "open sidebar", "close sidebar", "sidebar"], "action": { "type": "keys", "keys": "cmd+b" }, "say": "Sidebar" },
    { "id": "code_palette", "app": "Visual Studio Code", "phrases": ["command palette"], "action": { "type": "keys", "keys": "cmd+shift+p" }, "say": "Command palette" },
    { "id": "code_open_file", "app": "Visual Studio Code", "phrases": ["open file {query}", "find file {query}"], "action": { "type": "sequence", "steps": ["cmd+p", "wait:150", "type:{query}"] }, "say": "Open file" },
    { "id": "code_terminal", "app": "Visual Studio Code", "phrases": ["toggle terminal", "open terminal", "terminal"], "action": { "type": "keys", "keys": "ctrl+`" }, "say": "Terminal" },
    { "id": "code_save", "app": "Visual Studio Code", "phrases": ["save", "save file"], "action": { "type": "keys", "keys": "cmd+s" }, "say": "Saved" },
    { "id": "code_search", "app": "Visual Studio Code", "phrases": ["search for {query}"], "action": { "type": "sequence", "steps": ["cmd+shift+f", "wait:150", "type:{query}"] }, "say": "Search" },

    { "id": "finder_sidebar", "app": "Finder", "phrases": ["toggle sidebar", "open sidebar", "close sidebar", "sidebar"], "action": { "type": "keys", "keys": "ctrl+cmd+s" }, "say": "Sidebar" },
    { "id": "finder_downloads", "app": "Finder", "phrases": ["downloads", "open downloads"], "action": { "type": "keys", "keys": "cmd+opt+l" }, "say": "Downloads" },
    { "id": "finder_desktop", "app": "Finder", "phrases": ["desktop", "open desktop"], "action": { "type": "keys", "keys": "cmd+shift+d" }, "say": "Desktop" },
    { "id": "finder_home", "app": "Finder", "phrases": ["home", "home folder"], "action": { "type": "keys", "keys": "cmd+shift+h" }, "say": "Home" },
    { "id": "finder_new_folder", "app": "Finder", "phrases": ["new folder"], "action": { "type": "keys", "keys": "cmd+shift+n" }, "say": "New folder" },
    { "id": "finder_back", "app": "Finder", "phrases": ["go back", "back"], "action": { "type": "keys", "keys": "cmd+[" }, "say": "Back" },
    { "id": "finder_up", "app": "Finder", "phrases": ["go up", "parent folder"], "action": { "type": "keys", "keys": "cmd+up" }, "say": "Up" }
  ],
  "macros": {
    "study mode": ["open chrome", "new tab", "open claude", "new chat"],
    "coding mode": ["open visual studio code", "toggle terminal", "open chrome"]
  }
}
